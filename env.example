# ===============================================
# STOA Agent - Configuração
# ===============================================

# OpenAI API
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
OPENAI_MODEL=gpt-4.1-mini

# OpenWeather API (opcional para dados reais de clima)
# Pega em: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# Configurações do servidor
HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=false
STOA_STATE_DB=.stoa_state.db

# Localização padrão
LOCATION=Chapada dos Guimarães, Mato Grosso, BR
LAT=-15.4667
LON=-55.7500

# Timezone
TIMEZONE=America/Cuiaba

# Modo de execução
ENVIRONMENT=development
