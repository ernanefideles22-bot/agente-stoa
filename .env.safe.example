# Copie para .env.safe e preencha apenas o que for necessário.
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui
OPENWEATHER_API_KEY=
STOA_ACCESS_TOKEN=troque-este-token-por-um-segredo-forte

# Porta publicada apenas no localhost da sua máquina.
HOST_PORT=18000

# Configuração mínima do app.
PORT=8000
DEBUG=False
BIND_HOST=0.0.0.0
ALLOWED_HOSTS=127.0.0.1,localhost
LOCATION=Chapada dos Guimarães, Mato Grosso, BR
LAT=-15.4667
LON=-55.7500
# claude-haiku-4-5-20251001 = rápido e barato | claude-sonnet-4-6 = mais capaz
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_ROUTER_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_PLANNER_MODEL=claude-sonnet-4-6
ANTHROPIC_SYNTHESIS_MODEL=claude-sonnet-4-6
ANTHROPIC_AUTOPILOT_MODEL=claude-sonnet-4-6
MAX_PROMPT_CHARS=4000
MAX_PLAN_STEPS=4
MAX_STEP_OUTPUT_CHARS=1200
MAX_SESSION_MESSAGES=12
AUTOPILOT_MAX_FILES=8
QUEUE_WORKER_INTERVAL_SECONDS=10
PROJECT_SUPERVISOR_INTERVAL_SECONDS=45
PROJECT_SUPERVISOR_ENABLED=True
DAILY_BRIEFING_INTERVAL_SECONDS=300
DAILY_BRIEFING_ENABLED=True
STOA_WAKE_WORD=stoa
STOA_VOICE_ENDPOINT=http://127.0.0.1:18000/api/coworker/intake
STOA_VOICE_MODE=builder
STOA_VOICE_SESSION_ID=
STOA_VOICE_CONFIDENCE=0.70
STOA_VOICE_COOLDOWN_SECONDS=8
AUTO_SAVE_ARTIFACTS=True
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
AUDIT_LOG_PATH=logs/audit.log
SESSION_STORE_PATH=data/sessions.json
COWORKER_STORE_PATH=data/coworker.json
TERMINAL_TIMEOUT_SECONDS=20
ALLOWED_COMMAND_PREFIXES=python|--version;python|-m|pip|list;git|status;git|diff;git|log;dir;Get-ChildItem
ALLOWED_APPS=notepad,code,cursor,excel
ALLOWED_BROWSERS=msedge,chrome,firefox
ALLOWED_BROWSER_DOMAINS=localhost,127.0.0.1
EXTERNAL_ALLOWED_ROOTS=projeto=C:\caminho\do\projeto;outro=C:\outro\caminho
WORKSPACE_ROOT=workspace
EDITABLE_EXTENSIONS=.md,.txt,.html,.css,.js,.json,.py,.csv,.xlsx
ENABLED_MODULES=weather,time,planning,web,education,strategy,code,info
